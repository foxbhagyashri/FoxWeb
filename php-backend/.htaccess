# ── Protect sensitive files ───────────────────────────────────────────────────
<FilesMatch "^(config\.php|mailer\.php|helpers\.php|composer\.(json|lock)|\.env)$">
    Require all denied
</FilesMatch>

# ── Pretty-URL routing → index.php ────────────────────────────────────────────
Options -Indexes
RewriteEngine On

# Pass existing files/directories through unchanged
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.php
RewriteRule ^ index.php [QSA,L]
